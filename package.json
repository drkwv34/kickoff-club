{
  "name": "kickoff-club",
  "version": "0.0.0-scaffold",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:verify": "tsx src/lib/db/verify-schema.ts",
    "openspec:validate": "npx --yes @fission-ai/openspec@latest validate --all"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.4",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
