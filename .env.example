# Local development — copy to `.env` (never commit secrets)

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL (Compose service `db`) — required at boot; used by pnpm db:migrate
DATABASE_URL=postgresql://kickoff:kickoff@localhost:5432/kickoff

# Sessions (min 32 chars) — replace in any shared environment
SESSION_SECRET=local-dev-only-change-me-min-32-chars

# Mailpit (Compose service `mailpit`)
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional structured log level (debug | info | warn | error)
# LOG_LEVEL=info
